# =============================================================================
# قاعدة البيانات (Database) — PostgreSQL
# =============================================================================
# محلياً: استخدم قاعدة Postgres مجانية (نفس القاعدة التي تربطها في Vercel عبر
# تبويب Storage تكفي أيضاً للتطوير المحلي — انسخ نفس الرابط هنا).
# على Vercel: من تبويب المشروع → Storage → Create Database → Postgres، ثم
# اربطها بالمشروع (Connect) — سيضيف Vercel متغير DATABASE_URL تلقائياً، لا
# حاجة لأي إعداد يدوي إضافي.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# =============================================================================
# لوحة التحكم الإدارية (Admin)
# =============================================================================
# غيّر هذه القيمة قبل النشر! كلمة المرور الافتراضية معروفة للجميع.
ADMIN_PASSWORD=zshop2024

# غيّرها إلى نص عشوائي طويل قبل النشر (مثال: openssl rand -hex 32)
ADMIN_SESSION_SECRET=change-me-to-a-random-secret

# =============================================================================
# عنوان الموقع (يُستخدم في SEO / sitemap / روابط البريد / Stripe redirect)
# =============================================================================
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_STORE_URL=https://your-domain.com

# اسم المتجر (اختياري، له قيمة افتراضية في الكود)
STORE_NAME=وميض ستور
STORE_NAME_EN=Wameed Store

# =============================================================================
# Stripe — الدفع بالبطاقة الائتمانية (اختياري، الدفع عند الاستلام يعمل افتراضياً)
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# المفتاح العام يجب أن يبدأ بـ NEXT_PUBLIC_ ليصل إلى المتصفح
NEXT_PUBLIC_STRIPE_PK=

# =============================================================================
# البريد الإلكتروني — إشعارات الطلبات (اختياري)
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
STORE_EMAIL=
